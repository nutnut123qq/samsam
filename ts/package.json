{
  "name": "samsam-ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc -p packages/core && tsc -p apps/api && tsc -p apps/web",
    "test": "vitest run",
    "db:template": "tsx packages/core/src/testing/setup-template.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
