  ],
  "SQL": {
   "A": "select id from content_drafts where status = 'approved' and not coalesce(verify_publish('content_draft', id::text, text), false) order by id",
   "B": "select q.id, q.object_type, q.block from approval_queue q where q.status = 'approved' and (encode(sha256(convert_to(q.payload, 'UTF8')), 'hex') is distinct from q.content_sha256 or not exists (select 1 from approvals a where a.object_type = q.object_type and a.object_id = q.object_id and a.decision = 'approved' and a.content_sha256 = q.content_sha256 and a.approved_at <= q.decided_at)) order by q.id",
   "C": "select a.id, a.object_type from approvals a where not exists (select 1 from agent_action_log l where l.action = any(%s) and l.detail ->> 'approval_id' = a.id::text and l.object_id = a.object_id and l.actor = a.approved_by and l.db_role = a.db_role and l.ts = a.approved_at) order by a.id",
   "D": "select 'content_drafts', d.id, null::text from approvals a join content_drafts d on a.object_type = 'content_draft' and a.object_id = d.id::text where a.decision = 'approved' and lower(btrim(regexp_replace(a.approved_by, '\\s+', ' ', 'g'))) = lower(btrim(regexp_replace(d.created_by, '\\s+', ' ', 'g'))) union all select 'approval_queue', q.id, q.block from approval_queue q where q.status = 'approved' and lower(btrim(regexp_replace(q.decided_by, '\\s+', ' ', 'g'))) = lower(btrim(regexp_replace(q.created_by, '\\s+', ' ', 'g'))) union all select 'cogs_versions', c.id, null from cogs_versions c where c.approved_by is not null and lower(btrim(regexp_replace(c.approved_by, '\\s+', ' ', 'g'))) = lower(btrim(regexp_replace(c.created_by, '\\s+', ' ', 'g'))) order by 1, 2",
   "E": "select q.id, q.object_type, q.block from approval_queue q where q.status = 'approved' and q.qa_status = 'fail' and not exists (select 1 from decisions d where d.queue_id = q.id and d.kind = 'override_qa') order by q.id",
   "OVR": "select d.id, d.queue_id, q.block, q.object_type, d.created_at, d.decided_by, d.reason, q.created_by, q.decided_by, q.status from decisions d join approval_queue q on q.id = d.queue_id where d.kind = 'override_qa' and d.created_at >= %s and d.created_at < %s order by d.id",
   "BASIS": "select l.id, l.basis_id from decision_log l left join approval_queue q on q.id = l.basis_id where l.entry_kind = 'quyet_dinh' and l.basis_kind = 'approval_queue' and (q.id is null or q.status not in ('approved', 'rejected')) order by l.id",
   "PRIV": "select c.relname, p.priv from pg_class c cross join unnest(array['INSERT', 'UPDATE', 'DELETE', 'TRUNCATE']) p(priv) where c.relnamespace = current_schema()::regnamespace and c.relkind in ('r', 'p') and case when p.priv in ('INSERT', 'UPDATE') then has_any_column_privilege(%s, c.oid, p.priv) else has_table_privilege(%s, c.oid, p.priv) end order by 1, 2",
   "FUNC": "select p.oid::regprocedure::text from pg_proc p where p.pronamespace = current_schema()::regnamespace and p.prosecdef and p.proname <> all(%s) and has_function_privilege(%s, p.oid, 'EXECUTE') order by 1",
   "MEMBER": "select a.rolname, b.rolname from pg_roles a join pg_roles b on a.oid <> b.oid where a.rolname = any(%s) and b.rolname = any(%s) and pg_has_role(a.oid, b.oid, 'USAGE')",
   "SEL": "select c.relname from pg_class c where c.relnamespace = current_schema()::regnamespace and c.relkind in ('r', 'p', 'v', 'm') and (has_table_privilege(%s, c.oid, 'SELECT') or has_any_column_privilege(%s, c.oid, 'SELECT')) order by 1"
  }
