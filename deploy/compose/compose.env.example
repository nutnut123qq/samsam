# Mẫu biến cho docker-compose.yml. Trên server: sao thành compose.env (gitignored), thay MỌI
# CHANGE_ME bằng giá trị sinh ngẫu nhiên (vd `openssl rand -hex 24`). KHÔNG commit compose.env.
# DSN: mật khẩu có ký tự đặc biệt phải URL-encode.

# IP của server trên WireGuard (wg0) — mọi cổng chỉ mở trên IP này
WG_BIND_IP=10.8.0.1
WEB_PUBLIC_URL=https://app.samsam.internal
KC_PUBLIC_URL=https://sso.samsam.internal

# Postgres nghiệp vụ (owner chỉ để apply_schema, KHÔNG dùng cho dịch vụ)
POSTGRES_OWNER=samsam_owner
POSTGRES_PASSWORD=CHANGE_ME
# Login dịch vụ riêng (docs/roles.sql khối v14.2 + svc_ui) — Bên B tạo NGOÀI git
UI_DATABASE_URL=postgresql://svc_ui_login:CHANGE_ME@postgres:5432/samsam
WEBHOOK_DATABASE_URL=postgresql://svc_webhook_login:CHANGE_ME@postgres:5432/samsam
JOB_DATABASE_URL=postgresql://svc_job_login:CHANGE_ME@postgres:5432/samsam
LOADER_DATABASE_URL=postgresql://svc_loader_login:CHANGE_ME@postgres:5432/samsam
BACKUP_DATABASE_URL=postgresql://svc_backup_login:CHANGE_ME@postgres:5432/samsam

REDIS_PASSWORD=CHANGE_ME

KC_DB_PASSWORD=CHANGE_ME
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME

# Thư mục model OCR/STT tải sẵn (offline) trên server — runbook 10.11
AI_MODELS_DIR=/srv/samsam/models
# data/ thật của repo trên server (cấu hình data/*.json + file runtime)
SAMSAM_DATA_DIR=/srv/samsam/repo/data

# Cloud chỉ khi data/ai_policy.json cho phép đúng tính năng — để trống = không gọi cloud
ANTHROPIC_API_KEY=
# 1 = gửi thật ra Zalo/Meta — chỉ bật khi Bên B duyệt
DEPLOY=0

# Webhook kênh chat (api). Chế độ thực thiếu ZALO_OA_SECRET → /zalo-webhook 503; Messenger thiếu
# app secret → 403. Muối băm user ≥ 32 ký tự (`openssl rand -hex 32`), KHÔNG đổi sau khi chạy thật.
ZALO_OA_SECRET=CHANGE_ME
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=
MESSENGER_APP_SECRET=CHANGE_ME
MESSENGER_VERIFY_TOKEN=CHANGE_ME
MESSENGER_PAGE_TOKEN=
CHANNEL_HASH_SALT=CHANGE_ME

# Cảnh báo đỏ (worker) — người nhận ở data/red_alert_routing.json (`email:<địa chỉ>`; dạng `$BIEN`
# thì thêm BIEN vào environment của worker trong docker-compose.yml)
RED_ALERT_NOTIFY=email
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HEALTH_NOTIFY=
HEALTH_MAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Job lịch chạy bằng worker BullMQ (tên trong deploy/onprem/jobs.json, cách nhau dấu phẩy). TRỐNG = worker
# KHÔNG chạy (exit 78). `all` = cả lịch trừ restore_drill/dr_drill — chỉ khi KHÔNG còn timer systemd nào.
# Job còn bật systemd timer (Python) KHÔNG được có ở đây — README mục 7.
WORKER_JOBS=
