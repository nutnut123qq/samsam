# v15.1 — lịch job 'dealer_price_watch' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer dealer_price_watch

[Timer]
OnCalendar=*-*-* 08:50:00
Persistent=true
Unit=samsam-job@dealer_price_watch.service

[Install]
WantedBy=timers.target
