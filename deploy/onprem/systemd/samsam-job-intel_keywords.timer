# v15.1 — lịch job 'intel_keywords' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer intel_keywords

[Timer]
OnCalendar=Mon *-*-* 07:45:00
Persistent=true
Unit=samsam-job@intel_keywords.service

[Install]
WantedBy=timers.target
