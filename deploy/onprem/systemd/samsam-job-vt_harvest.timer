# Đợt hợp đồng C11 — lịch job 'vt_harvest' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer vt_harvest

[Timer]
OnCalendar=Mon *-*-* 08:20:00
Persistent=true
Unit=samsam-job@vt_harvest.service

[Install]
WantedBy=timers.target
