# Đợt hoàn thiện 22/10 — lịch job 'vt_pests' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer vt_pests

[Timer]
OnCalendar=*-*-* 06:35:00
Persistent=true
Unit=samsam-job@vt_pests.service

[Install]
WantedBy=timers.target
