# v15.1 — lịch job 'order_watch' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer order_watch

[Timer]
OnCalendar=*-*-* 08:40:00
Persistent=true
Unit=samsam-job@order_watch.service

[Install]
WantedBy=timers.target
