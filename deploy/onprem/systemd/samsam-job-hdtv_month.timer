# Đợt hợp đồng C11 — lịch job 'hdtv_month' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer hdtv_month

[Timer]
OnCalendar=*-*-03 08:30:00
Persistent=true
Unit=samsam-job@hdtv_month.service

[Install]
WantedBy=timers.target
