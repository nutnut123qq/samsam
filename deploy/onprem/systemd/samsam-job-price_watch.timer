# docx P2 — lịch job 'price_watch' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer price_watch

[Timer]
OnCalendar=*-*-* 08:25:00
Persistent=true
Unit=samsam-job@price_watch.service

[Install]
WantedBy=timers.target
