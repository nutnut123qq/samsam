# Đợt hợp đồng C12 — lịch job 'channel_scan' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer channel_scan

[Timer]
OnCalendar=*-*-* 07:00:00
Persistent=true
Unit=samsam-job@channel_scan.service

[Install]
WantedBy=timers.target
