# Đợt hợp đồng C11 — lịch job 'vt_weather' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer vt_weather

[Timer]
OnCalendar=*-*-* 06:30:00
Persistent=true
Unit=samsam-job@vt_weather.service

[Install]
WantedBy=timers.target
