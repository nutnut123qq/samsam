# v15.1 — lịch job 'sales_sla' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer sales_sla

[Timer]
OnCalendar=*-*-* *:10/30:00
Persistent=true
Unit=samsam-job@sales_sla.service

[Install]
WantedBy=timers.target
