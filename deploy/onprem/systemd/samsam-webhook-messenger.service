# Đợt hợp đồng C01 — dịch vụ webhook Messenger chạy 24/7 (PL01 Kinh doanh
# "chatbot 24/7"). Mẫu: chép vào /etc/systemd/system/, sửa <...>,
# `systemctl daemon-reload`. Repo KHÔNG tự cài/bật. Có cấu hình ≠ đã vận hành
# 24/7 — bằng chứng vận hành = journal + job `webhook_health` trên server Bên B.
# Secret/DSN ở EnvironmentFile NGOÀI repo (chmod 600, chủ tài khoản vận hành):
# biến xem deploy/onprem/webhook-env.example. DB = login dịch vụ svc_webhook
# qua WEBHOOK_DATABASE_URL (auth.bind_service — chế độ thực từ chối
# owner/superuser). Lỗi cấu hình → tiến trình exit 1 → systemd khởi động lại
# theo Restart=, quá StartLimitBurst trong StartLimitIntervalSec → failed
# (job webhook_health báo đỏ).
[Unit]
Description=Sam Sam webhook Messenger
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=<tai_khoan_van_hanh>
WorkingDirectory=<duong_dan_repo>
Environment=TZ=Asia/Ho_Chi_Minh
Environment=PYTHONIOENCODING=utf-8
EnvironmentFile=/etc/samsam/webhook.env
ExecStart=<duong_dan_python> -m connectors.messenger
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
