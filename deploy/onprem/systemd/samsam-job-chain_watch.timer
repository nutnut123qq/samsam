# Đợt hợp đồng — lịch job 'chain_watch' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer chain_watch

[Timer]
OnCalendar=*-*-* 06:20:00
Persistent=true
Unit=samsam-job@chain_watch.service

[Install]
WantedBy=timers.target
