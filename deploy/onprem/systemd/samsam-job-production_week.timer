# docx P2 — lịch job 'production_week' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer production_week

[Timer]
OnCalendar=Mon *-*-* 08:10:00
Persistent=true
Unit=samsam-job@production_week.service

[Install]
WantedBy=timers.target
