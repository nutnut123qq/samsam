# docx P2 — lịch job 'production_month' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer production_month

[Timer]
OnCalendar=*-*-01 08:15:00
Persistent=true
Unit=samsam-job@production_month.service

[Install]
WantedBy=timers.target
