# docx P2 — lịch job 'ceo_audit' (nguồn: deploy/onprem/jobs.json). Khung giờ GIẢ ĐỊNH —
# chủ khối chỉnh trong jobs.json rồi sửa OnCalendar ở đây (test giữ khớp).
[Unit]
Description=Sam Sam timer ceo_audit

[Timer]
OnCalendar=*-*-* 09:10:00
Persistent=true
Unit=samsam-job@ceo_audit.service

[Install]
WantedBy=timers.target
