# Mẫu env cho Postgres managed trong nước (v3.6) — CHỈ placeholder <...>.
# Chép thành .env trên VM rồi điền; KHÔNG commit file đã điền.

# App + backup (role app/backup — xem deploy/cloud/README.md mục 2)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/samsam?sslmode=require
# Có CA nhà cung cấp: thêm &sslmode=verify-full&sslrootcert=<duong-dan-ca.pem>

# Server diễn tập riêng (VM diễn tập) — trống = dùng server của DATABASE_URL
DRILL_DATABASE_URL=postgresql://<user>:<password>@<drill-host>:<port>/postgres?sslmode=require

# Backup (scripts/db_backup.py) — thư mục NGOÀI repo
BACKUP_DIR=<duong-dan-thu-muc-backup-tren-VM>
BACKUP_KEEP=7
# dir:<duong-dan> | s3://<bucket>/<prefix> (S3 = external-dep, chưa gọi thật)
BACKUP_OFFSITE=
# File khóa từ secret manager (ngoài repo); trống = backup chưa mã hóa
BACKUP_PASSPHRASE_FILE=
# Thư mục chứa pg_dump/pg_restore (trống = tự tìm PATH/bộ cài/docker)
PG_BIN=

# Object storage S3-compatible (Bizfly/Backblaze) — external-dep, để trống
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
