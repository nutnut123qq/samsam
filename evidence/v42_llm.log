# Tổng lời gọi guardrail_llm: 4 (<=5). Env: GUARDRAIL_LLM_MODEL=<model>, LLM_PROVIDER_ONLY=google-vertex trên chính lệnh (provider_only toàn cục không đổi).
# Chi phí đọc từ llm_usage (agent_id='guardrail_llm') của DB dev samsam_infra.

## Lần 1 — google/gemini-2.0-flash-001: provider trả 404 'No endpoints found' (model hết endpoint ZDR trên google-vertex) -> lớp LLM fail-closed THẬT (llm_check_unavailable), bài luật chặn 0 call
model=google/gemini-2.0-flash-001 provider_only=google-vertex
sach       llm_check=unavailable  ok=False calls=1 codes=['llm_check_unavailable']
           detail='lớp LLM-check không chấm được (gateway/provider lỗi hoặc timeout) — cần người duyệt xem' span=None
an-y       llm_check=unavailable  ok=False calls=1 codes=['llm_check_unavailable']
           detail='lớp LLM-check không chấm được (gateway/provider lỗi hoặc timeout) — cần người duyệt xem' span=None
luat-chan  llm_check=skipped      ok=False calls=0 codes=['tu_cam']
tổng call: 2 (agent {'guardrail_llm'})
llm_usage guardrail_llm từ lúc chạy: 2 dòng, ok=0, cost_usd=0.000000

