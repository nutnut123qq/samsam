# --- Core (bắt buộc mọi chế độ) ---
# Postgres local: db `samsam`, schema docs/schema.sql
DATABASE_URL=postgresql://user:password@localhost:5432/samsam
# OpenRouter — 1 key dùng cho cả chat lẫn embeddings (openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
OR_CHAT_MODEL=openai/gpt-4o-mini
OR_EMBED_MODEL=openai/text-embedding-3-small

# --- Zalo OA (chỉ cần khi chạy connectors.zalo) ---
# developers.zalo.me → app → thông tin ứng dụng
ZALO_APP_ID=
# App secret key — oauth refresh token (header secret_key).
# KHÁC OA secret bên dưới — đừng trộn.
ZALO_APP_SECRET=
# OA secret key — verify signature webhook
# sha256(appId + data + timestamp + OAsecretKey). Nguồn: OA console
# (oa.zalo.me → quản lý OA → webhook/secret).
ZALO_OA_SECRET=
# Token seed lần đầu — sau lần refresh đầu, data/zalo_tokens.json là
# source-of-truth (access ~25h; refresh 3 tháng, ROTATE mỗi lần dùng —
# file tokens phải còn nguyên).
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
# Port webhook (mặc định 8788)
ZALO_WEBHOOK_PORT=8788

# --- Deploy flag ---
# 1/true/yes = production: refuse-to-serve khi thiếu ZALO_OA_SECRET hoặc
# không có cách nào send (ACCESS_TOKEN ∨ REFRESH_TOKEN+APP_ID+APP_SECRET).
# Mọi giá trị khác = dev: signature bị bypass — KHÔNG public.
DEPLOY=

# --- Giám sát vận hành (v3.7, scripts/health_bulletin.py) ---
# Mặc định KHÔNG gửi: chỉ gửi khi chạy với --notify VÀ cấu hình đủ kênh.
# Kênh: email | telegram (để trống = không gửi). Người nhận/bot thật do
# công ty cấp (external-dep).
HEALTH_NOTIFY=
# Email (SMTP + STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
HEALTH_MAIL_TO=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Stack giám sát local (deploy/docker-compose.monitoring.yml) ---
# Khóa mã hóa credential n8n — BẮT BUỘC, chuỗi ngẫu nhiên dài, giữ cố
# định (đổi = mất credential đã lưu). Tài khoản owner n8n / admin Uptime
# Kuma tạo ở lần mở UI đầu, không ghi ở đây.
N8N_ENCRYPTION_KEY=

# --- Số hóa tài liệu (python -m ingest.doc_intake, F15.1) ---
# Thư mục intake: thư mục con = doc_type (giay_tiep_nhan/nhan/
# hop_dong_dai_ly/ho_so_vung_trong; khác -> khac). Mặc định data/intake/
# (gitignored). Intake không xoá/di chuyển file.
DOC_INTAKE_DIR=
# Kho bản gốc bất biến originals/<sha256> (mặc định data/originals/,
# gitignored). Cloud có object-lock = external-dep.
DOC_ORIGINALS_DIR=
# Provider OCR cho PDF scan/ảnh. Chỉ hỗ trợ `none` (không OCR -> cho_ocr,
# không gọi mạng). FPT.AI Reader (trong nước, có phí) / Google Vision
# (nước ngoài: phiếu tầng 2 + TIA, CẤM cho tài liệu có PII) = external-dep,
# chưa cắm — đặt tên khác `none` thì CLI exit 2.
OCR_PROVIDER=none

# --- Đăng nhập Streamlit (v3.4, pipelines/auth.py) — FAIL-CLOSED ---
# auth.py tự đọc .env (env process ưu tiên) — AUTH_MODE/AUTH_USERS_FILE/
# DEPLOY ở đây có hiệu lực ngay lần chạy đầu của Streamlit.
# Trống/lạ = CHẶN mọi truy cập. Giá trị:
#   proxy — danh tính từ header Cf-Access-Authenticated-User-Email do
#           reverse proxy (Cloudflare Access) đặt; CHỈ an toàn khi
#           Streamlit bind 127.0.0.1 sau proxy (docs/deploy.md).
#   local — đăng nhập user/mật khẩu (scrypt) theo AUTH_USERS_FILE; sai 5
#           lần liên tiếp khóa 5 phút.
#   dev   — không đăng nhập (identity dev, role tgd) — chỉ máy dev; bị
#           chặn khi DEPLOY=1.
AUTH_MODE=
# File users (mặc định data/users.json — gitignored; mẫu
# data/users.example.json; hash tạo bằng `python -m pipelines.auth --hash`)
AUTH_USERS_FILE=

# --- Kho tư liệu vườn (python scripts/garden_media.py, v9.3) ---
# Thư mục kho ảnh vườn ĐÃ gỡ EXIF/GPS, lưu <sha[:2]>/<sha>.<ext>. BẮT BUỘC
# nằm NGOÀI repo (trong repo -> script từ chối exit 2); nên có backup.
GARDEN_MEDIA_DIR=
