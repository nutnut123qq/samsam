# --- Core (bắt buộc mọi chế độ) ---
# Postgres local: db `samsam`, schema docs/schema.sql
DATABASE_URL=postgresql://user:password@localhost:5432/samsam
# OpenRouter — 1 key dùng cho cả chat lẫn embeddings (openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
OR_CHAT_MODEL=openai/gpt-4o-mini
OR_EMBED_MODEL=openai/text-embedding-3-small

# --- Guardrail LLM-check phụ + red-team (v4.2) — đọc LÚC GỌI ---
# Model lớp LLM-check (pipelines/guardrail_llm.py, agent guardrail_llm).
# Trống = TẮT lớp LLM (chỉ luật). Khuyến nghị khác họ model content;
# model chính thức do công ty chốt (external-dep). Lỗi/timeout/vượt trần
# -> llm_check_unavailable (chặn, người duyệt xem).
GUARDRAIL_LLM_MODEL=
# Timeout giây cho 1 lời gọi LLM-check (mặc định 20).
GUARDRAIL_LLM_TIMEOUT=20
# Model sinh biến thể red-team (scripts/redteam.py --generate) — PHẢI khác
# họ OR_CHAT_MODEL (vd google/... khi content là openai/...). Chạy kèm
# LLM_PROVIDER_ONLY=<provider của model> trên CHÍNH lệnh đó.
REDTEAM_MODEL=

# --- Zalo OA (chỉ cần khi chạy connectors.zalo) ---
# developers.zalo.me → app → thông tin ứng dụng
ZALO_APP_ID=
# App secret key — oauth refresh token (header secret_key).
# KHÁC OA secret bên dưới — đừng trộn.
ZALO_APP_SECRET=
# OA secret key — verify signature webhook
# sha256(appId + data + timestamp + OAsecretKey). Nguồn: OA console
# (oa.zalo.me → quản lý OA → webhook/secret).
ZALO_OA_SECRET=
# Token seed lần đầu — sau lần refresh đầu, data/zalo_tokens.json là
# source-of-truth (access ~25h; refresh 3 tháng, ROTATE mỗi lần dùng —
# file tokens phải còn nguyên).
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=
# Port webhook (mặc định 8788)
ZALO_WEBHOOK_PORT=8788

# --- Messenger (v5.1, connectors/messenger.py) — giá trị THẬT = external-dep ---
# Cần Meta app review + Page token + webhook HTTPS public trước khi bật cho
# khách thật (và DPIA/TIA đã ký). DEPLOY tắt = không gửi gì ra Meta.
# App secret (Meta app → Settings → Basic) — verify X-Hub-Signature-256.
# KHÔNG có bypass dev: trống = mọi POST bị 403.
MESSENGER_APP_SECRET=
# Page access token — gửi qua header Authorization: Bearer (không vào URL).
MESSENGER_PAGE_TOKEN=
# Chuỗi tự đặt, khai trong Meta webhook config (GET hub.verify_token).
MESSENGER_VERIFY_TOKEN=
# Port webhook (mặc định 8789)
MESSENGER_WEBHOOK_PORT=8789
# Muối HMAC cho user_hash của lớp kênh (chat_consents + payload handoff),
# ≥16 ký tự ngẫu nhiên, công ty giữ, KHÔNG đổi sau khi chạy (đổi = mất liên
# kết đồng ý cũ). Trống: Zalo bỏ qua ghi đồng ý/handoff; Messenger DEPLOY = fatal.
CHANNEL_HASH_SALT=

# --- Deploy flag ---
# 1/true/yes = production: refuse-to-serve khi thiếu ZALO_OA_SECRET hoặc
# không có cách nào send (ACCESS_TOKEN ∨ REFRESH_TOKEN+APP_ID+APP_SECRET).
# Mọi giá trị khác = dev: signature bị bypass — KHÔNG public.
DEPLOY=

# --- Giám sát vận hành (v3.7, scripts/health_bulletin.py) ---
# Mặc định KHÔNG gửi: chỉ gửi khi chạy với --notify VÀ cấu hình đủ kênh.
# Kênh: email | telegram (để trống = không gửi). Người nhận/bot thật do
# công ty cấp (external-dep).
HEALTH_NOTIFY=
# Email (SMTP + STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
HEALTH_MAIL_TO=
# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Stack giám sát local (deploy/docker-compose.monitoring.yml) ---
# Khóa mã hóa credential n8n — BẮT BUỘC, chuỗi ngẫu nhiên dài, giữ cố
# định (đổi = mất credential đã lưu). Tài khoản owner n8n / admin Uptime
# Kuma tạo ở lần mở UI đầu, không ghi ở đây.
N8N_ENCRYPTION_KEY=

# --- Số hóa tài liệu (python -m ingest.doc_intake, F15.1) ---
# Thư mục intake: thư mục con = doc_type (giay_tiep_nhan/nhan/
# hop_dong_dai_ly/ho_so_vung_trong; khác -> khac). Mặc định data/intake/
# (gitignored). Intake không xoá/di chuyển file.
DOC_INTAKE_DIR=
# Kho bản gốc bất biến originals/<sha256> (mặc định data/originals/,
# gitignored). Cloud có object-lock = external-dep.
DOC_ORIGINALS_DIR=
# Provider OCR cho PDF scan/ảnh. Chỉ hỗ trợ `none` (không OCR -> cho_ocr,
# không gọi mạng). FPT.AI Reader (trong nước, có phí) / Google Vision
# (nước ngoài: phiếu tầng 2 + TIA, CẤM cho tài liệu có PII) = external-dep,
# chưa cắm — đặt tên khác `none` thì CLI exit 2.
OCR_PROVIDER=none

# --- Đăng nhập Streamlit (v3.4, pipelines/auth.py) — FAIL-CLOSED ---
# auth.py tự đọc .env (env process ưu tiên) — AUTH_MODE/AUTH_USERS_FILE/
# DEPLOY ở đây có hiệu lực ngay lần chạy đầu của Streamlit.
# Trống/lạ = CHẶN mọi truy cập. Giá trị:
#   proxy — danh tính từ header Cf-Access-Authenticated-User-Email do
#           reverse proxy (Cloudflare Access) đặt; CHỈ an toàn khi
#           Streamlit bind 127.0.0.1 sau proxy (docs/deploy.md).
#   local — đăng nhập user/mật khẩu (scrypt) theo AUTH_USERS_FILE; sai 5
#           lần liên tiếp khóa 5 phút.
#   dev   — không đăng nhập (identity dev, role tgd) — chỉ máy dev; bị
#           chặn khi DEPLOY=1.
AUTH_MODE=
# File users (mặc định data/users.json — gitignored; mẫu
# data/users.example.json; hash tạo bằng `python -m pipelines.auth --hash`)
AUTH_USERS_FILE=

# --- Kho tư liệu vườn (python scripts/garden_media.py, v9.3) ---
# Thư mục kho ảnh vườn ĐÃ gỡ EXIF/GPS, lưu <sha[:2]>/<sha>.<ext>. BẮT BUỘC
# nằm NGOÀI repo (trong repo -> script từ chối exit 2); nên có backup.
GARDEN_MEDIA_DIR=

# --- Tài liệu kỹ thuật MẬT cơ khí (v9.5, python -m agents.ck_mat) ---
# Thư mục tài liệu MẬT (bản vẽ tủ điện, sơ đồ đấu nối...). Mặc định
# data/co_khi_mat/ (gitignored). Mọi file ở đây = confidential: chỉ tra
# cứu LOCAL (BM25, OCR rapidocr local nếu có) — không LLM/embed/mạng;
# ingest.kb_internal từ chối file trong thư mục này. Firewall chặn outbound
# máy chạy luồng mật = external-dep (Quản lý hạ tầng AI).
CK_MAT_DIR=

# --- Intel nhập tay (v7.2, python -m ingest.intel_import --social) ---
# Muối sha256 dedup comment/inbox kênh sở hữu (≥16 ký tự ngẫu nhiên).
# Quản lý hạ tầng AI sinh và GIỮ CỐ ĐỊNH (đổi muối = mất dedup với dữ
# liệu cũ). Thiếu → --social exit 1, không nạp.
INTEL_HASH_SALT=

# --- CRM contact_vault (v5.2, python -m ingest.crm) ---
# Khóa Fernet mã hóa SĐT/tên/email/địa chỉ khách trong bảng `contacts`
# (+ dẫn xuất khóa HMAC tra trùng SĐT). Sinh 1 lần:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KHÔNG commit, backup TÁCH khỏi backup DB (mất khóa = mất PII). Trống/sai
# = --add-contact/--handoff dừng exit 2, không ghi PII. Khóa thật do công
# ty giữ (external-dep).
CONTACT_VAULT_KEY=

# --- Ảnh AI (MKT-03, v6.2 — python -m pipelines.image_studio) ---
# Provider nền ảnh. Chỉ hỗ trợ `none` (nền gradient tất định, 0 lời gọi
# mạng). API sinh ảnh có phí (OpenAI/Google/Stability…) = external-dep: cần
# key + hợp đồng + bọc kill/cap/usage như llm_gateway trước khi cắm — đặt
# tên khác `none` thì CLI exit 2.
IMAGE_PROVIDER=none
# Thư mục packshot THẬT do công ty cấp: <PACKSHOT_DIR>/<sku_key>.png (PNG
# nền trong suốt). Mặc định data/packshots/ (gitignored).
PACKSHOT_DIR=
# Thư mục ảnh nháp output <sha256>.png + sidecar .json. Mặc định
# data/image_assets/ (gitignored).
IMAGE_OUT_DIR=
# Font thương hiệu (external-dep) — trống = font hệ thống trong
# data/image_studio.json (phải đủ glyph tiếng Việt, kiểm từng ký tự).
IMAGE_FONT=

# --- Connector API sàn CHỈ ĐỌC (v10.3, ingest/market_api.py) — external-dep ---
# App trên Shopee Partner Center / TikTok Shop Partner Center CHỈ xin quyền
# ĐỌC (listing/đơn). Thiếu/rỗng bất kỳ biến của kênh → exit 2, 0 request,
# không connect DB. KHÔNG ghi giá trị vào tài liệu/chat.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
# Trống = https://partner.shopeemobile.com. Chỉ nhận https://<host> hoặc
# http://127.0.0.1|localhost (server giả khi test).
SHOPEE_API_BASE=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_CIPHER=
TIKTOK_ACCESS_TOKEN=
# Trống = https://open-api.tiktokglobalshop.com (cùng luật như trên).
TIKTOK_API_BASE=

# --- Backend vector của chatbot (v10.3, api/rag.py) ---
# float8 (mặc định, cosine numpy) | pgvector (cần `apply_schema.py
# --pgvector` + `vector_eval.py` PASS). Giá trị khác → lỗi. Rollback = float8.
RAG_VECTOR_BACKEND=float8
